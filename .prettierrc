{
  "semi": true,
  "trailingComma": "none",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "jsxSingleQuote": true,
  "embeddedLanguageFormatting": "auto",
  "plugins": ["prettier-plugin-apex", "@prettier/plugin-xml"],
  "overrides": [
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc"
      }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "*.{cls,trigger}",
      "options": {
        "parser": "apex",
        "printWidth": 100,
        "tabWidth": 4,
        "apexInsertFinalNewline": true
      }
    },
    {
      "files": "*.{js,ts}",
      "options": {
        "parser": "typescript",
        "printWidth": 80,
        "tabWidth": 2,
        "semi": true,
        "singleQuote": true,
        "trailingComma": "none"
      }
    },
    {
      "files": "*.{html,htm}",
      "options": {
        "parser": "html",
        "printWidth": 100,
        "tabWidth": 2,
        "htmlWhitespaceSensitivity": "css",
        "bracketSameLine": false,
        "singleAttributePerLine": false
      }
    },
    {
      "files": "*.{css,scss}",
      "options": {
        "parser": "css",
        "printWidth": 80,
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": "*.{json,jsonc}",
      "options": {
        "parser": "json",
        "printWidth": 80,
        "tabWidth": 2,
        "trailingComma": "none"
      }
    }
  ]
}
