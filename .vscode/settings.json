{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[apex]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.apivcs": true,
    "**/.gitignore": true,
    "**/.designer.json": true,
    "**/.exchange.xml": true,
    "**/.vscode": true,
    "**/.mvn": true,
    "**/.tmp": true,
    "**/.settings": true,
    "**/.exchange_modules_tmp": true,
    ".mule": true
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#8c1004",
    "activityBar.background": "#8c1004"
  }
}